# Gerado automaticamente por npm run local:setup. Apenas testes locais.
APP_MODE=local-test
APP_ORIGIN=http://127.0.0.1:3002
DATABASE_URL=postgres://descomplica_local@127.0.0.1:54339/descomplica_local
TEST_DATABASE_URL=postgres://descomplica_local@127.0.0.1:54339/descomplica_test
LOCAL_ACCESS_CODE=
LOCAL_SECRET=

# Opcionais: somente credenciais Stripe TESTE; nunca reutilizar webhook de outro app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Homologação pública: APP_MODE=staging-test e PREVIEW_ACCESS_CODE são configurados na Vercel.
# Não compartilhar valores reais nem versionar .env.local.

# Server-only: one bounded intent call, never on page load or option clicks.
OPENAI_API_KEY=
AI_ENABLED=true
# Homolog defaults: 500 calls/day, conservative reservations of USD 0.004/call.
AI_DAILY_CALL_LIMIT=500
AI_DAILY_BUDGET_MICRO_USD=2000000
