{
  "name": "descomplica-operacao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "local:setup": "node scripts/local-setup.mjs",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.local scripts/test.mjs",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "db:migrate:neon": "node --env-file=.env.migration.local --import tsx scripts/migrate-neon.ts",
    "deploy:staging": "node scripts/deploy-staging.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^22.6.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
