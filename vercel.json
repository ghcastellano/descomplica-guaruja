{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/montar",
      "destination": "/?utm_source=instagram&utm_medium=bio#quiz",
      "permanent": false
    },
    {
      "source": "/bio",
      "destination": "/?utm_source=instagram&utm_medium=bio#quiz",
      "permanent": false
    },
    {
      "source": "/stories",
      "destination": "/?utm_source=instagram&utm_medium=stories#quiz",
      "permanent": false
    },
    {
      "source": "/insta",
      "destination": "/?utm_source=instagram&utm_medium=direct#quiz",
      "permanent": false
    },
    {
      "source": "/apresentacao-executiva",
      "destination": "/resumo-executivo",
      "permanent": false
    },
    {
      "source": "/parceria",
      "destination": "/parceria-pousadas",
      "permanent": false
    },
    {
      "source": "/pousadas",
      "destination": "/parceria-pousadas",
      "permanent": false
    },
    {
      "source": "/apresentacao",
      "destination": "/parceria-pousadas",
      "permanent": false
    },
    {
      "source": "/resumo",
      "destination": "/resumo-executivo",
      "permanent": false
    },
    {
      "source": "/futuro",
      "destination": "/visao",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.png|apple-touch-icon.png|og-image.png|logo.png|logo.webp|deck.css|deck.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(visao|resumo-executivo|parceria-pousadas|cultura-setur)(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
